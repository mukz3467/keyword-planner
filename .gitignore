:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  line-height: 1.5;
  color: #e7edf7;
  background: #091321;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-width: 100%;
  background: linear-gradient(180deg, #091321 0%, #101d2d 100%);
}

body {
  min-height: 100vh;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  border: none;
  border-radius: 10px;
  background: linear-gradient(135deg, #4f8cff, #3eb5ff);
  color: white;
  cursor: pointer;
  padding: 0.8rem 1.1rem;
  font-weight: 600;
  transition: 0.2s ease;
}

button:hover {
  transform: translateY(-1px);
}

button.secondary {
  background: #122239;
  border: 1px solid #29486d;
}

button.danger {
  background: #3b1d2c;
  color: #ffb8d0;
}

input,
select,
textarea {
  width: 100%;
  border-radius: 10px;
  border: 1px solid #2f4565;
  background: rgba(14, 23, 36, 0.85);
  color: #edf4ff;
  padding: 0.75rem 0.85rem;
}

textarea {
  resize: vertical;
}

label {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
  font-size: 0.88rem;
  color: #bfd4f4;
}

.app-shell {
  width: min(1400px, calc(100% - 32px));
  margin: 0 auto;
  padding: 2rem 0 3rem;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.eyebrow {
  margin: 0 0 0.3rem;
  font-size: 0.76rem;
  text-transform: uppercase;
  color: #70b9ff;
  letter-spacing: 0.12em;
}

h1 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 3rem);
}

h2 {
  margin-top: 0;
  font-size: 1.2rem;
}

h3 {
  margin: 0 0 0.8rem;
  font-size: 1rem;
}

.actions {
  display: flex;
  gap: 0.8rem;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(180px, 1fr));
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.stat-card,
.panel {
  background: rgba(15, 24, 38, 0.9);
  border: 1px solid #233752;
  border-radius: 18px;
  box-shadow: 0 14px 30px rgba(0, 0, 0, 0.18);
}

.stat-card {
  padding: 1rem 1.1rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.stat-card span {
  color: #a3bddf;
  font-size: 0.8rem;
}

.stat-card strong {
  font-size: 1.8rem;
}

.panel-grid {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 1rem;
  margin-bottom: 1rem;
}

.panel {
  padding: 1rem 1.1rem;
}

.keyword-form,
.filters {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.field-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
}

.button-row {
  display: flex;
  gap: 0.8rem;
}

.mini-summary {
  margin-top: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}

.channel-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(18, 33, 51, 0.9);
  border: 1px solid #2f4565;
  border-radius: 10px;
  padding: 0.7rem 0.8rem;
}

.table-wrap {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 1000px;
}

th,
td {
  border-bottom: 1px solid #213651;
  padding: 0.9rem 0.7rem;
  text-align: left;
  vertical-align: top;
}

th {
  color: #a3bddf;
  font-weight: 600;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.keyword-cell {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.keyword-cell small,
td small {
  color: #9db6d8;
  display: block;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.35rem 0.55rem;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 700;
  background: rgba(79, 140, 255, 0.2);
  color: #b7d6ff;
  border: 1px solid rgba(79, 140, 255, 0.4);
}

.pill.high-priority {
  background: rgba(79, 255, 164, 0.12);
  color: #9ef8c3;
  border-color: rgba(79, 255, 164, 0.35);
}

.pill.medium {
  background: rgba(255, 177, 66, 0.12);
  color: #ffd48a;
  border-color: rgba(255, 177, 66, 0.35);
}

.pill.low {
  background: rgba(255, 116, 116, 0.12);
  color: #ffb0b0;
  border-color: rgba(255, 116, 116, 0.35);
}

@media (max-width: 900px) {
  .stats-grid,
  .panel-grid,
  .field-row {
    grid-template-columns: 1fr;
  }

  .topbar,
  .button-row,
  .actions {
    flex-direction: column;
    align-items: stretch;
  }
}
